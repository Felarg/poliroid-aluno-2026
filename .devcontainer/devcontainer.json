{
  "name": "Poliroid",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash .devcontainer/setup-codespaces-env.sh",
  "forwardPorts": [3000, 9000, 9001],
  "portsAttributes": {
    "3000": {
      "label": "Poliroid",
      "onAutoForward": "openBrowser"
    },
    "9000": {
      "label": "MinIO API e imagens",
      "onAutoForward": "silent"
    },
    "9001": {
      "label": "Console do MinIO",
      "onAutoForward": "silent"
    }
  }
}
